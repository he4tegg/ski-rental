# Skopiuj do .env i uzupełnij: cp .env.example .env
JWT_SECRET=zmien-mnie-na-dlugi-losowy-ciag
# Model czatu: z kluczem używany jest Claude API; bez klucza lokalny model z Ollamy, jeśli ustawiony;
# bez obu asystent zwraca same pasujące fragmenty artykułów.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
# Np. Ollama zainstalowana na Macu (szybka, na GPU): OLLAMA_LLM_MODEL=qwen3:4b i OLLAMA_LLM_URL=http://host.docker.internal:11434
OLLAMA_LLM_MODEL=
OLLAMA_LLM_URL=
# Próg podobieństwa fragmentu do pytania. Opis zakładał wstępnie 0,75; dla bge-m3 pytania z bazy dają 0,52–0,68, a spoza tematu 0,25–0,42
PROG_PODOBIENSTWA=0.5
